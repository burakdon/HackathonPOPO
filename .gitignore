# Secrets: never commit. Copy .env.example to .env and fill in locally.
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
*.egg-info/

# Training artifacts and live-session data (overrides from demos live under runs/)
runs/
*.ckpt
checkpoints/

.DS_Store

# Third-party raw data: re-fetch with scripts/fetch_data.py (see data/README.md)
data/raw/

# Simulated response-probability grids for model fitting (rebuilt on demand)
data/cache/

# Derived PSST codings contain AphasiaBank transcripts: regenerate with scripts/code_psst_responses.py, share directly, do not commit
data/derived/*.csv
