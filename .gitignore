# Secrets: never commit. Copy .env.example to .env and fill in locally.
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
*.egg-info/

# Training artifacts and live-session data (overrides from demos live under runs/)
runs/
*.ckpt
checkpoints/

.DS_Store

# Third-party raw data. What the demo and the engine need at runtime IS committed (IPNP norms and
# pictures, Brysbaert concreteness, Middleton 2019 open data). Not committed: PSST archives (TalkBank
# transcripts; fetch with scripts/fetch_data.py) and paper PDFs/texts (copyright; fetch likewise).
data/raw/psst/
data/raw/refs/
data/raw/**/*.pdf
data/raw/**/*.html

# Caches ARE committed so a fresh clone starts the demo in seconds: the fitted SP grid, the lexicon
# with its embeddings, and WordNet. Rebuilt automatically if missing.

# Derived PSST codings contain AphasiaBank transcripts: regenerate with scripts/code_psst_responses.py, share directly, do not commit
data/derived/*.csv

# demo recordings: keep the mp4 and captions, not the raw webm
results/demo/_video/
results/demo/*.webm
data/raw/**/*.zip
